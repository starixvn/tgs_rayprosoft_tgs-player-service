<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Version>0.2.7</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <UserSecretsId>0323e457-f31b-4a28-ae5d-37c780c3b49f</UserSecretsId>
    <DockerfileTag Condition="$(DockerfileTag) == ''">player-api</DockerfileTag>
    <ContainerRepository>player-api</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Sentry.AspNetCore" Version="4.10.2" />
    <PackageReference Include="FluentdForward.OpenTelemetry.MessagePack" Version="0.3.7" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.19.6" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.8.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.OpenTelemetry" Version="8.0.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.7.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.7.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.7.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.7.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.7.0" />
    <PackageReference Include="PagingUtility.AsyncEnumerable" Version="1.1.0" />
    <PackageReference Include="ProfileViewer.OpenTelemetry.Exporter" Version="0.3.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="Tgs.WebApi.Toolkits" Version="0.4.0" />
    <PackageReference Include="Tgs.WebApi.Toolkits.Swashbuckle" Version="0.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlayerService.Core.Cache\PlayerService.Core.Cache.csproj" />
    <ProjectReference Include="..\PlayerService.Core\PlayerService.Core.csproj" />
    <ProjectReference Include="..\PlayerService.Repositories\PlayerService.Repositories.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.UAT.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
