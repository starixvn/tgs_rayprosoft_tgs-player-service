<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.0.27</Version>
    <LangVersion>10</LangVersion>
    <Authors>Raypro</Authors>
    <PackageId>Tgs.PlayerService.Client</PackageId>
    <Product>Tgs.PlayerService.Client</Product>
    <PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-player-service</PackageProjectUrl>
    <RepositoryUrl>https://gitlab.com/rayprosoft/tgs-player-service.git</RepositoryUrl>
    <PackageTags>tgs player service</PackageTags>
    <RootNamespace>Tgs.PlayerService.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Http.Extensions" Version="2.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="5.0.0" Condition="'$(TargetFramework)' == 'net5.0'" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="6.0.0" Condition="'$(TargetFramework)' == 'net6.0'" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.3.44">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Interactive.Async" Version="6.0.1" />
  </ItemGroup>

</Project>
